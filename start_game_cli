#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -z "${SHOWDOWN_PATH:-}" ]]; then
  export SHOWDOWN_PATH="/home/alexqfmm/workPlace/pokemon/pokemonShowdowm/pokemon-showdown"
fi

if [[ ! -f "$SHOWDOWN_PATH/dist/sim/index.js" ]]; then
  echo "找不到 Pokemon Showdown 构建产物：$SHOWDOWN_PATH/dist/sim/index.js" >&2
  echo "请先执行：" >&2
  echo "  cd \"$SHOWDOWN_PATH\"" >&2
  echo "  npm ci" >&2
  echo "  node build --force" >&2
  exit 1
fi

if [[ $# -eq 1 && "$1" =~ ^[0-9]+$ ]]; then
  exec python3 changeBattle-cli/play.py --seed "$1"
fi

exec python3 changeBattle-cli/play.py "$@"
