{
  "name": "@changebattle-v2/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "renderer:dev": "vite --host 127.0.0.1 --port 5181",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/electron-vite.mjs build",
    "test:renderer-assets": "node scripts/assert-renderer-relative-assets.mjs",
    "test:asset-resolver": "tsc -p tsconfig.asset-resolver-test.json && node out/asset-resolver-test/rendererAssetResolver.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@changebattle-v2/api": "workspace:*",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "motion": "^12.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron-vite": "^4.0.1"
  }
}
