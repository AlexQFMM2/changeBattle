{
  "name": "@changebattle/mobile",
  "version": "0.7.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "node ../../tools/build_mobile_showdown_bundle.mjs && tsc -p tsconfig.json --noEmit && vite build && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync": "cap sync android",
    "android": "cap open android",
    "apk": "node scripts/build-android-debug.mjs",
    "apk:release": "node scripts/build-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@changebattle/game-service": "workspace:*",
    "@changebattle/game-runtime": "workspace:*",
    "@changebattle/shared": "workspace:*",
    "@vitejs/plugin-react": "^5.0.0",
    "motion": "^12.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.17.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
