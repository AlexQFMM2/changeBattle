{
  "name": "@changebattle-v2/showdown-battle-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./showdownCommand": {
      "types": "./src/showdownCommand.ts",
      "default": "./src/showdownCommand.ts"
    },
    "./teamGenerator": {
      "types": "./src/teamGenerator.ts",
      "default": "./src/teamGenerator.ts"
    },
    "./battleProfiles": {
      "types": "./src/battleProfiles.ts",
      "default": "./src/battleProfiles.ts"
    },
    "./battleIdentity": {
      "types": "./src/battleIdentity.ts",
      "default": "./src/battleIdentity.ts"
    },
    "./playbackCompiler": {
      "types": "./src/playbackCompiler.ts",
      "default": "./src/playbackCompiler.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.test.json && node dist-test/index.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {}
}
