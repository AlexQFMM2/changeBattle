{
  "name": "@changebattle-v2/showdown-battle-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "node": "./dist/types.js",
      "default": "./src/types.ts"
    },
    "./showdownCommand": {
      "types": "./src/showdownCommand.ts",
      "node": "./dist/showdownCommand.js",
      "default": "./src/showdownCommand.ts"
    },
    "./teamGenerator": {
      "types": "./src/teamGenerator.ts",
      "node": "./dist/teamGenerator.js",
      "default": "./src/teamGenerator.ts"
    },
    "./battleProfiles": {
      "types": "./src/battleProfiles.ts",
      "node": "./dist/battleProfiles.js",
      "default": "./src/battleProfiles.ts"
    },
    "./battleIdentity": {
      "types": "./src/battleIdentity.ts",
      "node": "./dist/battleIdentity.js",
      "default": "./src/battleIdentity.ts"
    },
    "./aiMoveEvaluator": {
      "types": "./src/aiMoveEvaluator.ts",
      "node": "./dist/aiMoveEvaluator.js",
      "default": "./src/aiMoveEvaluator.ts"
    },
    "./playbackCompiler": {
      "types": "./src/playbackCompiler.ts",
      "node": "./dist/playbackCompiler.js",
      "default": "./src/playbackCompiler.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ai:selfplay": "pnpm build && node dist/aiSelfPlayExamCli.js",
    "ai:teams": "pnpm build && node dist/aiTeamGenerationReportCli.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "start": "node dist/server.js",
    "test": "pnpm --filter @changebattle-v2/showdown-dex-core build && tsc -p tsconfig.test.json && node dist-test/index.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@changebattle-v2/showdown-dex-core": "workspace:*",
    "ts-chacha20": "^1.2.0"
  }
}
