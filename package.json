{
  "name": "change-battle",
  "version": "0.1.6",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "desktop:dev": "pnpm --filter @changebattle/desktop dev",
    "desktop:build": "pnpm --filter @changebattle/desktop build",
    "desktop:test:talents": "pnpm --filter @changebattle/desktop test:talents",
    "game:test:trainer-items": "pnpm --filter @changebattle/game-service test:trainer-items",
    "desktop:release:win": "python3 tools/package_desktop_release.py",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
