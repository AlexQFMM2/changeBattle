{
  "name": "change-battle-v2",
  "version": "0.1.14",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "web:dev": "pnpm --filter @changebattle-v2/core build && pnpm --filter @changebattle-v2/web dev",
    "battle:dev": "./start_desk --battle-only",
    "desk:dev": "./start_desk",
    "desktop:dev": "pnpm --filter @changebattle-v2/desktop dev",
    "audit:copy": "node scripts/audit-changebattle-copy.mjs",
    "test:identity-sync": "pnpm --filter @changebattle-v2/api test:identity-sync",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
